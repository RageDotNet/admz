{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admz.example/schemas/crm-search-request.json",
  "title": "CRM Search Request",
  "description": "Query CRM contacts by customer name and/or company name.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Customer or contact name to search for."
    },
    "company": {
      "type": "string",
      "minLength": 1,
      "description": "Company name to search for."
    }
  },
  "anyOf": [
    { "required": ["name"] },
    { "required": ["company"] }
  ],
  "additionalProperties": false
}
