{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admz.example/schemas/crm-add-note-response.json",
  "title": "CRM Add Note Response",
  "description": "The CRM contact record after the note was appended.",
  "type": "object",
  "properties": {
    "record": {
      "$ref": "#/$defs/contact",
      "description": "Updated CRM contact record."
    }
  },
  "required": ["record"],
  "additionalProperties": false,
  "$defs": {
    "contact": {
      "type": "object",
      "description": "A CRM contact record.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Contact identifier, e.g. c001."
        },
        "name": {
          "type": "string",
          "description": "Contact full name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Contact email address."
        },
        "company": {
          "type": "string",
          "description": "Company name."
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number."
        },
        "status": {
          "type": "string",
          "enum": ["active", "lead", "churned"],
          "description": "Contact account status."
        },
        "notes": {
          "type": "string",
          "description": "Free-text notes for the contact."
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "company",
        "phone",
        "status",
        "notes"
      ],
      "additionalProperties": false
    }
  }
}
